# Copy to .env and fill in real values - .env is gitignored.
# This repo is public - see README for why only placeholder values appear
# below.

# Every host:port Homepage is reached through, comma-separated, no spaces -
# confirmed required via Homepage's own install docs. localhost:3000 and
# 127.0.0.1:3000 are always allowed and don't need adding. Add your LAN
# IP:3000 here for the base (no-Traefik) deployment, or the real hostname
# (no port needed, since HTTPS/443 is the default) once the Traefik overlay
# is applied - both can be listed at once, comma-separated.
HOMEPAGE_ALLOWED_HOSTS=192.168.0.50:3000

# Optional - defaults shown.
#HOMEPAGE_VER=v2.7.0
#STACK_NAME=homepage

# Set to a real, pre-created absolute path (e.g. a ZFS/CephFS dataset) when
# deploying as a Portainer git-repository stack - see README/docker-compose.yml
# for why the relative default silently breaks there (Portainer CE only).
#HOMEPAGE_CONFIG_PATH=/mnt/pool/Apps/homepage/config

# Same deal for the secrets/ directory (widget credentials, e.g.
# secrets/proxmox_username, secrets/proxmox_password) - the compose file's
# secrets: block hits the identical Portainer path-resolution issue as
# config/ above, since a secret's file: source resolves the same way a
# bind-mount volume does.
#HOMEPAGE_SECRETS_PATH=/mnt/pool/Apps/homepage/secrets

# Traefik overlay only (docker-compose.traefik.yml).
NETWORK=traefik
HOMEPAGE_HOST=homepage.lan.example.internal
